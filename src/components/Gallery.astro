---
/**
 * One project's screenshots as a swipeable carousel (scroll-snap, so touch and
 * trackpads work natively) with arrows, a counter and dots. Clicking an image
 * opens it in the page's <Lightbox>, which pages through the same set.
 */
import { getImage } from 'astro:assets';
import Shot from './Shot.astro';
import type { Shot as ShotData } from '../data/projects';
import { t, type Lang } from '../i18n';

interface Props {
  shots: ShotData[];
  name: string;
  lang: Lang;
  eager?: boolean;
}
const { shots, name, lang, eager = false } = Astro.props;
const s = t(lang);
const n = shots.length;
const phonesOnly = shots.every((x) => x.frame === 'phone');
const full = await Promise.all(
  shots.map((x) => getImage({ src: x.src, width: Math.min(x.src.width, 2400), format: 'webp', quality: 85 })),
);
const items = shots.map((x, i) => ({
  src: full[i].src,
  w: full[i].attributes.width ?? x.src.width,
  h: full[i].attributes.height ?? x.src.height,
  alt: x.alt[lang],
  phone: x.frame === 'phone',
}));
---

<div
  class:list={['gallery', { 'gallery--phones': phonesOnly, 'gallery--single': n === 1 }]}
  data-gallery
  data-items={JSON.stringify(items)}
>
  <div
    class="track"
    role="region"
    aria-roledescription="carousel"
    aria-label={`${name} — ${s.galLabel}`}
    tabindex={n > 1 ? 0 : undefined}
  >
    {shots.map((x, i) => (
      <div
        class:list={['slide', `slide--${x.frame}`]}
        role="group"
        aria-roledescription="slide"
        aria-label={`${i + 1} ${s.galOf} ${n}`}
      >
        <button type="button" class="open" data-open={i} aria-label={`${s.galOpen}: ${x.alt[lang]}`}>
          <Shot shot={x} lang={lang} eager={eager && i === 0} />
          <span class="zoom" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="16" height="16"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </button>
      </div>
    ))}
  </div>

  {n > 1 && (
    <div class="controls">
      <button type="button" class="nav prev" data-prev aria-label={s.galPrev} disabled>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <span class="count label" aria-live="polite"><b data-current>1</b> {s.galOf} {n}</span>
      <span class="pips" aria-hidden="true">
        {shots.map((_, i) => <i class:list={{ on: i === 0 }} />)}
      </span>
      <button type="button" class="nav next" data-next aria-label={s.galNext}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
    </div>
  )}
</div>

<style>
  .gallery {
    /* the track bleeds into the gutter by --pad so the frame shadow is not cut off */
    --pad: 24px;
    position: relative;
  }
  @media (max-width: 700px) {
    .gallery {
      --pad: 12px;
    }
  }
  .track {
    container-type: inline-size;
    display: flex;
    align-items: center;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    /* room for the frame shadow without letting it spill into the next slide */
    padding-block: 12px 56px;
    margin: -12px calc(-1 * var(--pad)) -56px;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .track:focus-visible {
    outline: 2px solid var(--cobalt);
    outline-offset: 4px;
  }
  .slide {
    flex: 0 0 100%;
    display: flex;
    justify-content: center;
    padding-inline: var(--pad);
    scroll-snap-align: center;
    scroll-snap-stop: always;
  }
  .open {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: zoom-in;
    text-align: inherit;
    border-radius: 12px;
  }
  .open:focus-visible {
    outline: 2px solid var(--cobalt);
    outline-offset: 4px;
  }
  /* A phone among desktop shots: as tall as a 16:10 browser frame next to it. */
  .slide--phone .open {
    width: min(100%, calc(28.9cqw + 15px));
  }
  .gallery--phones .slide--phone .open {
    width: min(100%, 300px);
  }
  .gallery--phones .controls {
    max-width: 300px;
    margin-inline: auto;
  }
  .zoom {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    opacity: 0;
    transform: scale(0.9);
    transition: opacity 0.18s ease-out, transform 0.18s ease-out;
    pointer-events: none;
  }
  .open:hover .zoom,
  .open:focus-visible .zoom {
    opacity: 0.92;
    transform: none;
  }
  @media (hover: none) {
    .zoom {
      opacity: 0.85;
      transform: none;
    }
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
  }
  .nav {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
    transition: border-color 0.15s, color 0.15s, background-color 0.15s;
  }
  .nav:hover:not(:disabled) {
    border-color: var(--pen);
    color: var(--pen);
  }
  .nav:focus-visible {
    outline: 2px solid var(--cobalt);
    outline-offset: 2px;
  }
  .nav:disabled {
    opacity: 0.38;
    cursor: default;
  }
  .count {
    min-width: 5.5em;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .count b {
    color: var(--ink);
    font-weight: 600;
  }
  .pips {
    display: flex;
    gap: 6px;
    margin-right: auto;
  }
  .pips i {
    width: 18px;
    height: 3px;
    border-radius: 2px;
    background: var(--rule);
    transition: background-color 0.2s, width 0.2s;
  }
  .pips i.on {
    width: 30px;
    background: var(--pen);
  }
  /* counter and dots read left, the two arrows sit together on the right */
  .count {
    order: 0;
    text-align: left;
    min-width: 4.5em;
  }
  .pips {
    order: 1;
  }
  .prev {
    order: 2;
  }
  .next {
    order: 3;
  }

  @media (prefers-reduced-motion: reduce) {
    .zoom,
    .pips i,
    .nav {
      transition: none;
    }
  }
</style>

<script>
  const reduce = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const g of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const track = g.querySelector<HTMLElement>('.track')!;
    const slides = [...track.querySelectorAll<HTMLElement>('.slide')];
    const prev = g.querySelector<HTMLButtonElement>('[data-prev]');
    const next = g.querySelector<HTMLButtonElement>('[data-next]');
    const current = g.querySelector<HTMLElement>('[data-current]');
    const dots = [...g.querySelectorAll<HTMLElement>('.controls .pips i')];
    let index = 0;

    const go = (i: number) => {
      const j = Math.max(0, Math.min(slides.length - 1, i));
      track.scrollTo({ left: j * track.clientWidth, behavior: reduce() ? 'auto' : 'smooth' });
    };
    const sync = () => {
      const i = Math.round(track.scrollLeft / Math.max(1, track.clientWidth));
      if (i === index) return;
      index = i;
      if (current) current.textContent = String(i + 1);
      dots.forEach((d, k) => d.classList.toggle('on', k === i));
      slides.forEach((s, k) => s.toggleAttribute('inert', k !== i));
      if (prev) prev.disabled = i === 0;
      if (next) next.disabled = i === slides.length - 1;
    };
    slides.forEach((s, k) => s.toggleAttribute('inert', k !== 0));

    let raf = 0;
    track.addEventListener('scroll', () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(sync);
    }, { passive: true });
    prev?.addEventListener('click', () => go(index - 1));
    next?.addEventListener('click', () => go(index + 1));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); go(index + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(index - 1); }
    });
    // Keep the current slide in place when the layout width changes.
    new ResizeObserver(() => track.scrollTo({ left: index * track.clientWidth })).observe(track);

    const items = JSON.parse(g.dataset.items || '[]');
    track.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-open]');
      if (!btn) return;
      document.dispatchEvent(new CustomEvent('lightbox:open', {
        detail: {
          items,
          index: Number(btn.dataset.open),
          opener: btn,
          onIndex: (i: number) => track.scrollTo({ left: i * track.clientWidth }),
        },
      }));
    });
  }
</script>
