---
import Base from '../layouts/Base.astro';
import Fingerprint from '../components/Fingerprint.astro';
import { LANGS, SITE, langPath, t, type Lang } from '../i18n';
import { projects } from '../data/projects';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const alternates = Object.fromEntries(LANGS.map((l) => [l, langPath(l, 'about')]));

const bio: Record<Lang, string[]> = {
  en: [
    'I’m Erol Yılmaz. I studied Management Information Systems at Ankara Yıldırım Beyazıt University and work where software meets business processes.',
    'At IPCEU in Ankara I started as an IT and business development intern and stayed on as a junior system developer, taking a finance tracker and a task tracker from their first version to company-wide, daily use. Before that I spent a summer at the University of Stuttgart researching non-intrusive load monitoring in data centres, and handled partnerships and market research at BISTEK Software.',
    'Outside work I build tools for problems near me — a game server panel, a bulk mailer, a meal planner — and this blog is where I write down what each of them taught me.',
  ],
  de: [
    'Ich bin Erol Yılmaz. Ich habe Wirtschaftsinformatik an der Ankara Yıldırım Beyazıt Universität studiert und arbeite dort, wo Software auf Geschäftsprozesse trifft.',
    'Bei IPCEU in Ankara habe ich mit einem Praktikum in IT und Business Development angefangen und bin danach als Junior System Developer geblieben: Eine Finanz- und eine Aufgaben-App habe ich von der ersten Version bis zur täglichen Nutzung im ganzen Unternehmen gebracht. Davor habe ich einen Sommer an der Universität Stuttgart zu Non-Intrusive Load Monitoring in Rechenzentren geforscht und bei BISTEK Software Partnerschaften und Marktanalysen betreut.',
    'Daneben baue ich Werkzeuge für Probleme in meiner Nähe – ein Gameserver-Panel, ein Serienmail-Tool, einen Essensplaner – und schreibe hier auf, was mich jedes davon gelehrt hat.',
  ],
  tr: [
    'Ben Erol Yılmaz. Ankara Yıldırım Beyazıt Üniversitesi’nde Yönetim Bilişim Sistemleri okudum; yazılımla iş süreçlerinin kesiştiği yerde çalışıyorum.',
    'Ankara’da IPCEU’da BT ve iş geliştirme stajyeri olarak başladım, staj sonrası junior system developer olarak kaldım; bir finans takip ve bir görev takip uygulamasını ilk sürümünden şirket genelinde her gün kullanılır hâle getirdim. Öncesinde bir yaz Stuttgart Üniversitesi’nde veri merkezlerinde Non-Intrusive Load Monitoring üzerine araştırma yaptım, BISTEK Software’de uluslararası ortaklıklar ve pazar araştırmaları üzerinde çalıştım.',
    'İş dışında yakınımdaki dertlere araçlar yapıyorum — bir oyun sunucusu paneli, bir toplu mail aracı, bir yemek planlayıcı — ve bu blog, her birinin bana öğrettiklerini yazdığım yer.',
  ],
};

---

<Base lang={lang} title={s.aboutTitle} nav="about" alternates={alternates}>
  <section class="about wrap">
    <div class="plot" aria-hidden="true">
      <Fingerprint seed="erol" variant="post" />
    </div>
    <div class="copy">
      <h1>{s.aboutTitle}</h1>
      <div class="prose">
        {bio[lang].map((p) => <p>{p}</p>)}
      </div>
      <p class="label cvlink"><a href={langPath(lang, 'cv')}>{s.cvSeeCv} →</a></p>
    </div>
  </section>

  <section class="built wrap" aria-labelledby="built-h">
    <h2 id="built-h" class="label">{s.built}</h2>
    <ul class="list" role="list">
      {projects.map((p) => (
        <li>
          <a class="item" href={`${langPath(lang, 'work')}#${p.id}`}>
            <h3>{p.name}</h3>
            <p class="stack label">{p.stack}</p>
            <p class="what">{p.text[lang]}</p>
          </a>
        </li>
      ))}
    </ul>
    <p class="label more">
      <a href={langPath(lang, 'work')}>{s.seeAllWork} →</a> · <a href={SITE.github} rel="me">GitHub ↗</a>
    </p>
  </section>
</Base>

<style>
  .cvlink {
    margin: 22px 0 0;
  }
  .cvlink a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--cobalt);
  }
  .about {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: 48px;
    align-items: start;
    padding-block: clamp(40px, 6vw, 80px) 0;
  }
  .plot {
    position: sticky;
    top: 24px;
  }
  h1 {
    margin: 0 0 28px;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: var(--step-3);
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .copy .prose {
    font-size: 1.3rem;
  }
  .built {
    margin-top: clamp(56px, 8vw, 104px);
  }
  .built h2 {
    margin: 0 0 8px;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    border-top: 2px solid var(--ink);
  }
  .list li {
    padding: 24px 24px 28px 0;
    border-bottom: 1px solid var(--rule);
  }
  h3 {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: -0.02em;
  }
  .stack {
    margin: 6px 0 12px;
    color: var(--pen);
  }
  .what {
    margin: 0;
    line-height: 1.5;
  }
  .item {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .item:hover h3 {
    color: var(--pen);
  }
  .more {
    margin-top: 20px;
  }
  .more a {
    color: inherit;
  }

  @media (max-width: 800px) {
    .about {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .plot {
      position: static;
      max-width: 340px;
    }
  }
</style>
