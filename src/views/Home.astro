---
import Base from '../layouts/Base.astro';
import Fingerprint from '../components/Fingerprint.astro';
import { fingerprint } from '../lib/fingerprint';
import { postsIn, postHref, readingMinutes } from '../lib/posts';
import { LANGS, formatDate, isoDate, langPath, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const posts = await postsIn(lang);
const explainer = posts.find((p) => p.slug === 'every-post-has-a-fingerprint');
const ascii = fingerprint('erol').ascii;
const alternates = Object.fromEntries(LANGS.map((l) => [l, langPath(l)]));
---

<Base lang={lang} nav="writing" alternates={alternates}>
  <section class="hero wrap">
    <h1 class="lead">{s.heroLead}</h1>
    <div class="plot">
      <Fingerprint seed="erol" variant="hero" label={s.fpCaption} />
    </div>
    <div class="aside">
      <p class="sub">{s.heroSub}</p>
      <p class="caption label">
        {s.fpCaption}
        {explainer && (
          <>
            {' '}<a href={postHref(explainer)}>{s.fpHow} →</a>
          </>
        )}
      </p>
    </div>
    <pre class="ascii" aria-hidden="true">{ascii}</pre>
  </section>

  <section class="index wrap" aria-labelledby="writing-h">
    <h2 id="writing-h" class="label">{s.writing} <span class="count">{posts.length}</span></h2>
    {posts.length === 0 ? (
      <p class="empty">{s.noPosts}</p>
    ) : (
      <ol class="rows" role="list">
        {posts.map((p) => (
          <li>
            <a class="post-row" href={postHref(p)}>
              <span class="thumb" aria-hidden="true">
                <Fingerprint seed={p.slug} variant="thumb" />
              </span>
              <time class="label" datetime={isoDate(p.data.date)}>{formatDate(p.data.date, lang)}</time>
              <span class="text">
                <span class="title">{p.data.title}</span>
                <span class="desc">{p.data.description}</span>
              </span>
              <span class="label mins">
                {readingMinutes(p.body)} {s.minRead}
              </span>
            </a>
          </li>
        ))}
      </ol>
    )}
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    padding-block: clamp(40px, 7vw, 96px) 24px;
  }
  .lead {
    grid-column: 1 / 8;
    grid-row: 1;
    align-self: end;
    position: relative;
    z-index: 1;
    margin: 0;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: var(--step-3);
    line-height: 0.98;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .plot {
    grid-column: 6 / 13;
    grid-row: 1;
    align-self: end;
  }
  .aside {
    grid-column: 1 / 6;
    grid-row: 2;
    padding-top: 28px;
  }
  .sub {
    margin: 0;
    font-size: 1.3rem;
    line-height: 1.45;
    font-style: italic;
    color: var(--graphite);
    max-width: 34ch;
  }
  .caption {
    margin: 22px 0 0;
    max-width: 44ch;
    line-height: 1.7;
    text-transform: none;
    letter-spacing: 0.01em;
  }
  .caption a {
    color: var(--pen);
    white-space: nowrap;
  }
  .ascii {
    grid-column: 9 / 13;
    grid-row: 2;
    justify-self: end;
    align-self: start;
    margin: 28px 0 0;
    font-family: var(--f-mono);
    font-variation-settings: 'wdth' 100;
    font-size: 0.7rem;
    line-height: 1.25;
    color: var(--graphite);
  }

  .index {
    margin-top: clamp(40px, 6vw, 80px);
  }
  .index h2 {
    margin: 0 0 8px;
    display: flex;
    gap: 10px;
    align-items: baseline;
  }
  .count {
    color: var(--pen);
  }
  .empty {
    color: var(--graphite);
    font-style: italic;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 2px solid var(--ink);
  }
  .rows li {
    border-bottom: 1px solid var(--rule);
  }
  .post-row {
    display: grid;
    grid-template-columns: 88px 9.5rem 1fr auto;
    align-items: center;
    gap: 24px;
    padding-block: 22px;
    color: inherit;
    text-decoration: none;
  }
  .thumb {
    padding: 4px;
  }
  .text {
    display: grid;
    gap: 4px;
  }
  .title {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.12;
    letter-spacing: -0.02em;
    transition: color 0.2s var(--ease);
  }
  .desc {
    color: var(--graphite);
    line-height: 1.45;
    max-width: 60ch;
  }
  .post-row:hover .title,
  .post-row:focus-visible .title {
    color: var(--pen);
  }

  @media (max-width: 900px) {
    .lead {
      grid-column: 1 / -1;
    }
    .plot {
      grid-column: 3 / -1;
      grid-row: 2;
      margin-top: 24px;
    }
    .aside {
      grid-column: 1 / -1;
      grid-row: 3;
    }
    .ascii {
      display: none;
    }
    .post-row {
      grid-template-columns: 64px 1fr;
      gap: 6px 18px;
    }
    .thumb {
      grid-column: 1;
      grid-row: 1 / 4;
      align-self: start;
      padding: 4px 0 0;
    }
    .post-row time,
    .text,
    .mins {
      grid-column: 2;
    }
    .post-row time {
      grid-row: 1;
    }
    .text {
      grid-row: 2;
    }
    .mins {
      grid-row: 3;
    }
  }
</style>
