---
import Base from '../layouts/Base.astro';
import Fingerprint from '../components/Fingerprint.astro';
import Gallery from '../components/Gallery.astro';
import Lightbox from '../components/Lightbox.astro';
import { projects } from '../data/projects';
import { LANGS, langPath, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const alternates = Object.fromEntries(LANGS.map((l) => [l, langPath(l, 'work')]));
---

<Base lang={lang} title={s.workTitle} description={s.workIntro} nav="work" alternates={alternates}>
  <header class="intro wrap">
    <h1>{s.workTitle}</h1>
    <p class="lede">{s.workIntro}</p>
    <dl class="legend label">
      <div><dt><span class="tag real">{s.provReal}</span></dt><dd>{s.provRealNote}</dd></div>
      <div><dt><span class="tag mock">{s.provMock}</span></dt><dd>{s.provMockNote}</dd></div>
    </dl>
  </header>

  <ol class="projects wrap" role="list">
    {projects.map((p, i) => {
      const phoneOnly = p.shots.every((x) => x.frame === 'phone');
      return (
        <li class:list={['project', { flip: i % 2 === 1, 'phone-only': phoneOnly }]} id={p.id}>
          <div class="media">
            <Gallery shots={p.shots} name={p.name} lang={lang} eager={i === 0} />
          </div>
          <div class="copy">
            <div class="mark" aria-hidden="true"><Fingerprint seed={p.id} variant="thumb" /></div>
            <h2>{p.name}</h2>
            <p class="stack label">{p.stack}</p>
            <p class="what">{p.text[lang]}</p>
            <p class="meta">
              <span class:list={['tag label', p.kind]}>{p.kind === 'real' ? s.provReal : s.provMock}</span>
              {p.demo && <a class="label" href={p.demo}>{s.liveDemo} ↗</a>}
            </p>
          </div>
        </li>
      );
    })}
  </ol>
  <Lightbox lang={lang} />
</Base>

<style>
  .intro {
    padding-block: clamp(40px, 6vw, 80px) 8px;
  }
  h1 {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: var(--step-3);
    line-height: 1;
    letter-spacing: -0.035em;
  }
  .lede {
    max-width: 52ch;
    margin: 20px 0 0;
    font-size: 1.3rem;
    line-height: 1.45;
    font-style: italic;
    color: var(--graphite);
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 40px;
    margin: 28px 0 0;
    text-transform: none;
    letter-spacing: 0.01em;
  }
  .legend div {
    display: grid;
    gap: 8px;
    justify-items: start;
    max-width: 52ch;
    line-height: 1.6;
  }
  .legend dd {
    margin: 0;
  }
  .tag {
    display: inline-block;
    padding: 3px 9px;
    border-radius: 999px;
    border: 1px solid currentColor;
    white-space: nowrap;
    font-family: var(--f-mono);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .tag.real {
    color: var(--cobalt);
  }
  .tag.mock {
    color: var(--pen);
  }

  .projects {
    list-style: none;
    margin-top: clamp(40px, 6vw, 72px);
    padding-bottom: 0;
    display: grid;
    gap: clamp(64px, 9vw, 128px);
  }
  .project {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: 40px;
    align-items: center;
  }
  .project.flip {
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
  }
  .project.flip .media {
    order: 2;
  }
  .project.phone-only {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
  }
  .project.phone-only.flip {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }
  .media {
    min-width: 0;
  }
  .mark {
    width: 72px;
    margin-bottom: 14px;
  }
  h2 {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: var(--step-2);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .stack {
    margin: 10px 0 0;
  }
  .what {
    margin: 16px 0 0;
    line-height: 1.5;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
    margin: 18px 0 0;
  }
  .meta a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--cobalt);
  }

  @media (max-width: 900px) {
    .project,
    .project.flip,
    .project.phone-only,
    .project.phone-only.flip {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .project.flip .media {
      order: 0;
    }
  }
</style>
